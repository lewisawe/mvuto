{
  "name": "mvuto-mcp-server",
  "version": "1.0.0",
  "description": "MCP server 'mvuto-bodies' — serves celestial preset bodies for the Mvuto gravity sandbox, and generates the app's committed preset JSON from the same shared module.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "mvuto-bodies": "dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "export:presets": "tsx scripts/export-presets.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.19.2",
    "typescript": "5.9.3"
  }
}
